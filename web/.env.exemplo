# Copie para .env.local e preencha.
#
# Banco compartilhado. Em desenvolvimento, `npm run mongo:dev` sobe um
# MongoDB efêmero em mongodb://127.0.0.1:47017.
PAINEL_MONGO_URL=mongodb://127.0.0.1:47017
PAINEL_MONGO_BANCO=painel-analitico

# Obrigatória. A MESMA string em todas as instâncias, ou uma não lê o que a
# outra gravou: nome, CPF e matrícula ficam ilegíveis.
#   openssl rand -base64 32
PAINEL_CHAVE_DADOS=

# Duração da opção "manter conectado", em dias.
PAINEL_DIAS_SESSAO=14

# Porteiro na frente da URL (HTTP Basic), antes do login do painel.
# Obrigatório em produção: sem ele a aplicação responde 503 em vez de abrir.
PAINEL_USUARIO_SITE=painel
PAINEL_SENHA_SITE=
